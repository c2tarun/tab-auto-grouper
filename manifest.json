{
  "manifest_version": 3,
  "name": "Tab Auto Grouper",
  "version": "0.1.0",
  "description": "Automatically groups tabs with the tab they were opened from.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "service_worker": "background.js"
  }
}
